{
  "id": "office-info",
  "version": 1,
  "title": "Ask an office a general question",
  "callee_kinds": ["clinic", "dentist", "pharmacy", "other"],
  "slots": {
    "topic": {
      "type": "enum",
      "sources": ["stated"],
      "label": "Question",
      "required": true,
      "choices": {
        "hours": {"say": "your opening hours",
                  "show": "Their opening hours"},
        "fax_number": {"say": "your fax number",
                       "show": "Their fax number"},
        "address": {"say": "your street address",
                    "show": "Their street address"},
        "accepts_new_patients": {"say": "whether you are taking new patients",
                                 "show": "Whether they take new patients"}
      }
    }
  },
  "commitments": [],
  "request_template": "Could you tell me {topic}?",
  "outcome": {
    "answer_given": {"type": "bool"},
    "answer_time": {"type": "datetime"}
  }
}
