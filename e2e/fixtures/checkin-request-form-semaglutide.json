                  "valueCoding": {
                    "system": "https://smart-health-checkin.org/connectathon/CodeSystem/semaglutide-checkin",
                    "code": "no",
                    "display": "No"
                  }
                },
                {
                  "valueCoding": {
                    "system": "https://smart-health-checkin.org/connectathon/CodeSystem/semaglutide-checkin",
                    "code": "once",
                    "display": "Once"
                  }
